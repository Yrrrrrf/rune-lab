{
	"version": "0.5.4-rc.0",
	"description": "A modern, extensible plugin-based UI shell for Svelte 5 applications",
	"license": "MIT",
	"readme": "README.md",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Yrrrrrf/rune-lab.git"
	},
	"nodeModulesDir": "auto",
	"workspace": [
		"./src/packages/ui",
		"./src/packages/core",
		"./src/packages/plugins/api",
		"./src/packages/plugins/corpo",
		"./src/packages/plugins/i18n",
		"./src/packages/plugins/layout",
		"./src/packages/plugins/observer",
		"./src/packages/plugins/palettes"
	],
	"imports": {
		"svelte": "npm:svelte@^5",
		"vite-plus": "npm:vite-plus",
		"typescript": "npm:typescript",
		"@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte",
		"effect": "npm:effect@^3",
		"esm-env": "npm:esm-env@^1"
	},
	"test": {
		"exclude": ["apps/**", "src/packages/ui/**", "src/packages/plugins/**"]
	},
	"overrides": {
		"vite": "^8"
	}
}
